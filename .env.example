## Microsoft Foundry configuration
FOUNDRY_KEY = "<your-foundry-resource-key>"
PROJECT_ENDPOINT = "https://<your-foundry-resource>.services.ai.azure.com/api/projects/<your-project>"
OPENAI_ENDPOINT = "https://<your-foundry-resource>.openai.azure.com/openai/v1"
DEPLOYMENT_NAME = "gpt-5.4"

# Azure AI Services endpoints
LANGUAGE_ENDPOINT = "https://<your-language-resource>.cognitiveservices.azure.com/"
SPEECH_ENDPOINT = "https://<your-speech-resource>.cognitiveservices.azure.com/"
CONTENT_UNDERSTANDING_ENDPOINT = "https://<your-content-understanding-resource>.services.ai.azure.com/"

# Computer vision
IMAGE_MODEL = "gpt-image-1.5"
OPENAI_ENDPOINT_VISION = "https://<your-vision-resource>.openai.azure.com/openai/v1"

# Agent configuration
AGENT_NAME = "brezy-forecast-agent"
AGENT_VERSION = "2"
